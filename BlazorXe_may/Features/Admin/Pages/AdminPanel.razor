            await using var db = await DbFactory.CreateDbContextAsync();
            db.ThongBaoNguoiDungs.Add(new ThongBaoNguoiDung
            {
                TieuDe = ThongBaoForm.TieuDe.Trim(),
                NoiDung = ThongBaoForm.NoiDung.Trim(),
                NguoiDungId = ThongBaoForm.NguoiDungId
            });
            await db.SaveChangesAsync();
            await GhiNhatKyAsync("GuiThongBao", ThongBaoForm.TieuDe);
            ThongBaoForm = new NotificationForm();
            ThongBaos = await db.ThongBaoNguoiDungs.AsNoTracking().OrderByDescending(x => x.NgayTao).Take(200).ToListAsync();
        });
    }

    private async Task LuuCauHinhAsync()
    {
        await ThucHienAsync("settings.manage", async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var setting = await db.CauHinhCuaHangs.SingleOrDefaultAsync(x => x.Khoa == CauHinhForm.Khoa.Trim());
            if (setting is null)
            {
                db.CauHinhCuaHangs.Add(new CauHinhCuaHang { Khoa = CauHinhForm.Khoa.Trim(), GiaTri = CauHinhForm.GiaTri.Trim() });
            }
            else
            {
                setting.GiaTri = CauHinhForm.GiaTri.Trim();
            }

            await db.SaveChangesAsync();
            await GhiNhatKyAsync("CapNhatCauHinh", CauHinhForm.Khoa);
            CauHinhs = await db.CauHinhCuaHangs.AsNoTracking().OrderBy(x => x.Khoa).ToListAsync();
        });
    }

    private void ChonCauHinh(CauHinhCuaHang setting) =>
        CauHinhForm = new SettingForm { Khoa = setting.Khoa, GiaTri = setting.GiaTri };

    private async Task GanVaiTroAsync(AppUser employee, bool assign)
    {
        await ThucHienAsync("roles.manage", async () =>
        {
            if (NguoiDung is null || string.IsNullOrWhiteSpace(VaiTroChon))
                throw new InvalidOperationException("Hãy chọn một vai trò.");
            await DichVuQuanTri.GanVaiTroAsync(NguoiDung.Id, employee.Id, VaiTroChon, assign);
            await GhiNhatKyAsync(assign ? "GanVaiTro" : "ThuHoiVaiTro", $"{employee.Email}: {VaiTroChon}");
            VaiTroTheoNguoiDung[employee.Id] = (await UserManager.GetRolesAsync(employee)).ToList();
        });
    }

    private async Task GanChiNhanhAsync(AppUser employee, bool assign)
    {
        await ThucHienAsync("roles.manage", async () =>
        {
            if (ChiNhanhChon <= 0)
            {
                throw new InvalidOperationException("Hãy chọn chi nhánh cần gán hoặc thu hồi.");
            }

            await PermissionService.GanPhamViChiNhanhAsync(employee.Id, ChiNhanhChon, assign);
            await GhiNhatKyAsync(assign ? "GanPhamViChiNhanh" : "ThuHoiPhamViChiNhanh",
                $"{employee.Email}: {ChiNhanhChon}");
            await TaiDuLieuAsync();
        });
    }

    private void KiemTraPhamViChiNhanh(int branchId)
    {
        if (branchId <= 0 || !ToanHeThong && !ChiNhanhDuocCap.Contains(branchId))
        {
            throw new UnauthorizedAccessException("Chi nhánh nằm ngoài phạm vi được cấp.");
        }
    }

    private async Task KiemTraPhamViDonHangAsync(int orderId)
    {
        if (ToanHeThong)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.DonHangs.AnyAsync(x =>
                x.Id == orderId && ChiNhanhDuocCap.Contains(x.ChiNhanhId ?? 0)))
        {
            throw new UnauthorizedAccessException("Đơn hàng nằm ngoài phạm vi chi nhánh được cấp.");
        }
    }

    private async Task CapNhatQuyenAsync(int roleId, int permissionId, ChangeEventArgs args)
    {
        var allowed = args.Value is bool value && value;
        await ThucHienAsync("roles.manage", async () =>
        {
            await PermissionService.GanQuyenAsync(roleId, permissionId, allowed);
            if (allowed) QuyenDaGan.Add((roleId, permissionId));
            else QuyenDaGan.Remove((roleId, permissionId));
            await GhiNhatKyAsync("CapNhatQuyen", $"Vai trò {roleId}, quyền {permissionId}: {allowed}");
        });
    }

    private async Task GhiNhatKyAsync(string action, string detail)
    {
        if (NguoiDung is not null)
        {
            await DichVuNhatKy.GhiAsync(NguoiDung.Id, action, ModuleHienTai, detail);
        }
    }

    private async Task ThucHienAsync(string requiredPermission, Func<Task> operation)
    {
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await PermissionService.YeuCauQuyenAsync(state.User, requiredPermission);
            await operation();
            ThanhCong = true;
            ThongBao = "Đã lưu thay đổi.";
        }
        catch (UnauthorizedAccessException)
        {
            ThanhCong = false;
            ThongBao = "Tài khoản không được cấp quyền thực hiện thao tác này.";
        }
        catch (InvalidOperationException exception)
        {
            ThanhCong = false;
            ThongBao = exception.Message;
        }
        catch (DbUpdateException exception)
        {
            Logger.LogWarning(exception, "Không thể lưu dữ liệu cho phân hệ {Module}.", ModuleHienTai);
            ThanhCong = false;
            ThongBao = "Không thể lưu dữ liệu. Hãy kiểm tra mã định danh đã tồn tại và thử lại.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Thao tác thất bại trong phân hệ {Module}.", ModuleHienTai);
            ThanhCong = false;
            ThongBao = "Thao tác không thành công. Vui lòng thử lại.";
        }
    }

