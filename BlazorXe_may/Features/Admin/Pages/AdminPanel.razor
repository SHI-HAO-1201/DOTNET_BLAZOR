            user.DangHoatDong = !user.DangHoatDong;
            var result = await UserManager.UpdateAsync(user);
            if (!result.Succeeded) throw new InvalidOperationException(string.Join("; ", result.Errors.Select(x => x.Description)));
            await GhiNhatKyAsync("CapNhatTrangThaiKhachHang", user.Email ?? user.Id.ToString());
            await LoadCustomersAsync();
        });
    }

    private async Task XemKhachHangAsync(AppUser user)
    {
        await ThucHienAsync("customers.view", async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            KhachHangDangXem = await UserManager.FindByIdAsync(user.Id.ToString());
            var customerOrders = db.DonHangs.AsNoTracking()
                .Where(order => order.NguoiDungId == user.Id);
