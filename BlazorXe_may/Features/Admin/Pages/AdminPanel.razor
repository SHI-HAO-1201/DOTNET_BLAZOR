    private async Task TaoDonTaiQuayAsync()
    {
        await ThucHienAsync("orders.manage", async () =>
        {
            if (BanHangTaiQuay.KhachHangId <= 0 || BanHangTaiQuay.XeMayId <= 0 || BanHangTaiQuay.SoLuong <= 0)
                throw new InvalidOperationException("Hãy chọn khách hàng, xe và số lượng hợp lệ.");

            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();
            var product = await db.XeMays.SingleOrDefaultAsync(x => x.Id == BanHangTaiQuay.XeMayId && x.DangKinhDoanh)
                ?? throw new InvalidOperationException("Không tìm thấy xe cần bán.");
            if (product.SoLuong < BanHangTaiQuay.SoLuong) throw new InvalidOperationException("Tồn kho không đủ.");
            var customer = await db.Users.SingleOrDefaultAsync(x => x.Id == BanHangTaiQuay.KhachHangId && x.DangHoatDong)
                ?? throw new InvalidOperationException("Không tìm thấy khách hàng đang hoạt động.");
            var branchId = BanHangTaiQuay.ChiNhanhId;
            if (branchId <= 0 || !await db.ChiNhanhs.AnyAsync(x => x.Id == branchId && x.DangHoatDong)
                || !ToanHeThong && !ChiNhanhDuocCap.Contains(branchId))
                throw new InvalidOperationException("Hãy chọn chi nhánh đang hoạt động trong phạm vi được cấp.");
            if (!ToanHeThong
                && !await db.DonHangs.AnyAsync(x => x.NguoiDungId == customer.Id
                    && ChiNhanhDuocCap.Contains(x.ChiNhanhId ?? 0))
                && (!customer.ChiNhanhId.HasValue || !ChiNhanhDuocCap.Contains(customer.ChiNhanhId.Value)))
                throw new InvalidOperationException("Khách hàng không thuộc phạm vi chi nhánh được cấp.");
            var branchStock = await db.TonKhoChiNhanhs.SingleOrDefaultAsync(x =>
                x.XeMayId == product.Id && x.ChiNhanhId == branchId);
            if (branchStock is null || branchStock.SoLuong < BanHangTaiQuay.SoLuong)
                throw new InvalidOperationException("Tồn kho của chi nhánh không đủ.");
            branchStock.SoLuong -= BanHangTaiQuay.SoLuong;
            var order = new DonHangEntity
            {
                MaDonHang = $"POS-{DateTime.UtcNow:yyyyMMdd}-{Guid.NewGuid():N}"[..24].ToUpperInvariant(),
                NguoiDungId = customer.Id, ChiNhanhId = branchId, TrangThai = "HoanThanh",
                PhuongThucThanhToan = "TienMat",
                NguoiNhan = string.IsNullOrWhiteSpace(BanHangTaiQuay.NguoiNhan) ? customer.HoTen : BanHangTaiQuay.NguoiNhan,
                SoDienThoaiNhan = string.IsNullOrWhiteSpace(BanHangTaiQuay.SoDienThoai) ? customer.PhoneNumber ?? "" : BanHangTaiQuay.SoDienThoai,
                DiaChiNhan = BanHangTaiQuay.DiaChi,
                TamTinh = product.GiaBan * BanHangTaiQuay.SoLuong,
                TongTien = product.GiaBan * BanHangTaiQuay.SoLuong,
                ChiTiet = [new ChiTietDonHang { XeMayId = product.Id, TenXe = product.TenXe, DonGia = product.GiaBan, SoLuong = BanHangTaiQuay.SoLuong }]
            };
            product.SoLuong -= BanHangTaiQuay.SoLuong;
            db.DonHangs.Add(order);
            db.GiaoDichThanhToans.Add(new GiaoDichThanhToan { DonHang = order, PhuongThuc = "TienMat", TrangThai = "DaThuTien", SoTien = order.TongTien, NgayThanhToan = DateTime.UtcNow });
            db.BienDongKhos.Add(new BienDongKho { XeMayId = product.Id, ChiNhanhId = branchId, SoLuongThayDoi = -BanHangTaiQuay.SoLuong, LoaiGiaoDich = "BanTaiQuay", GhiChu = order.MaDonHang, NguoiTaoId = NguoiDung!.Id });
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            await GhiNhatKyAsync("BanTaiQuay", order.MaDonHang);
            BanHangTaiQuay = new PosForm();
            DonHangs = await DichVuQuanTri.LayDonHangAsync(ToanHeThong ? null : ChiNhanhDuocCap);
            DanhSachXe = await XeMayService.LayTatCaXeAsync();
        });
    }

