    private async Task LuuKhuyenMaiAsync()
    {
        await ThucHienAsync("products.manage", async () =>
        {
            if (KhuyenMaiForm.KetThuc <= KhuyenMaiForm.BatDau || KhuyenMaiForm.GiaTri <= 0
                || KhuyenMaiForm.DonToiThieu < 0
                || KhuyenMaiForm.TheoPhanTram && KhuyenMaiForm.GiaTri > 100)
                throw new InvalidOperationException("Thời gian hoặc giá trị khuyến mãi không hợp lệ.");
            await using var db = await DbFactory.CreateDbContextAsync();
            var code = KhuyenMaiForm.MaKhuyenMai.Trim().ToUpperInvariant();
            if (await db.KhuyenMais.AnyAsync(x => x.MaKhuyenMai == code && x.Id != KhuyenMaiForm.Id))
                throw new InvalidOperationException("Mã khuyến mãi này đã tồn tại.");
            var promotion = KhuyenMaiForm.Id == 0
                ? new KhuyenMai()
                : await db.KhuyenMais.SingleOrDefaultAsync(x => x.Id == KhuyenMaiForm.Id)
                    ?? throw new InvalidOperationException("Không tìm thấy mã khuyến mãi.");
            promotion.MaKhuyenMai = code;
            promotion.TenKhuyenMai = KhuyenMaiForm.TenKhuyenMai.Trim();
            promotion.GiaTri = KhuyenMaiForm.GiaTri;
            promotion.TheoPhanTram = KhuyenMaiForm.TheoPhanTram;
            promotion.DonToiThieu = KhuyenMaiForm.DonToiThieu;
            promotion.BatDau = DateTime.SpecifyKind(KhuyenMaiForm.BatDau.Date, DateTimeKind.Local).ToUniversalTime();
            promotion.KetThuc = DateTime.SpecifyKind(KhuyenMaiForm.KetThuc.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime();
            promotion.DangHoatDong = KhuyenMaiForm.DangHoatDong;
            if (KhuyenMaiForm.Id == 0)
            {
                db.KhuyenMais.Add(promotion);
            }
            await db.SaveChangesAsync();
            await GhiNhatKyAsync(KhuyenMaiForm.Id == 0 ? "ThemKhuyenMai" : "CapNhatKhuyenMai", code);
            KhuyenMaiForm = new PromotionForm();
            KhuyenMais = await db.KhuyenMais.AsNoTracking().OrderByDescending(x => x.BatDau).ToListAsync();
        });
    }

