@page "/admin"
@page "/admin/{Module}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "QuanTriVien,ChuCuaHang,QuanLy,BanHang,Kho,KeToan,BaoHanh,NhanVien")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using BlazorXe_Xemay.Features.DonHang
@using BlazorXe_Xemay.Features.Shared
@using BlazorXe_Xemay.Features.TaiKhoan
@using BlazorXe_Xemay.Features.XeMay.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using DonHangEntity = BlazorXe_Xemay.Features.TaiKhoan.DonHang
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<AppUser> UserManager
@inject RoleManager<IdentityRole<int>> RoleManager
@inject XeMayService XeMayService
@inject DichVuPhanQuyen PermissionService
@inject DichVuQuanTri DichVuQuanTri
@inject DichVuDonHang DichVuDonHang
@inject DichVuNhatKy DichVuNhatKy
@inject ILogger<AdminPanel> Logger

<PageTitle>@TenTrang - MotoHub quản trị</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">@TenTrang</h1>
        <p class="text-secondary mb-0">Quản lý hoạt động cửa hàng và dữ liệu nghiệp vụ.</p>
    </div>
    <span class="badge text-bg-light">@NguoiDung?.Email</span>
</div>

@if (!string.IsNullOrWhiteSpace(ThongBao))
{
    <div class="alert @(ThanhCong ? "alert-success" : "alert-danger")" role="status">@ThongBao</div>
}
@if (DangTai)
{
    <div class="alert alert-info">Đang tải dữ liệu...</div>
}
else if (!CoQuyen)
{
    <div class="alert alert-warning">Tài khoản của bạn chưa được cấp quyền xem phân hệ này.</div>
}
else
{
    @switch (ModuleHienTai)
    {
        case "dashboard":
            <section class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-4">
                <div class="col"><div class="stat-card"><span>Xe đang kinh doanh</span><strong>@(ThongKe?.SoXe ?? 0)</strong></div></div>
                <div class="col"><div class="stat-card"><span>Đơn chờ xác nhận</span><strong>@(ThongKe?.DonChoXacNhan ?? 0)</strong></div></div>
                <div class="col"><div class="stat-card"><span>Tài khoản khách hàng</span><strong>@(ThongKe?.KhachHang ?? 0)</strong></div></div>
                <div class="col"><div class="stat-card"><span>Yêu cầu bảo hành mở</span><strong>@(ThongKe?.YeuCauBaoHanh ?? 0)</strong></div></div>
            </section>
            <div class="card border-0 shadow-sm p-3">
                <h2 class="h5">Đơn hàng gần đây</h2>
                @RenderOrders(ThongKe?.DonHangMoiNhat ?? [])
            </div>
            break;
        case "san-pham":
            <div class="row g-4">
                <section class="col-xl-4">
                    <EditForm Model="XeForm" OnValidSubmit="LuuXeAsync" class="card border-0 shadow-sm p-3">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />
                        <h2 class="h5">@(XeForm.Id == 0 ? "Thêm xe mới" : $"Sửa {XeForm.TenXe}")</h2>
                        <label class="form-label">Mã xe</label><InputText class="form-control mb-2" @bind-Value="XeForm.MaXe" />
                        <label class="form-label">Tên xe</label><InputText class="form-control mb-2" @bind-Value="XeForm.TenXe" />
                        <label class="form-label">Hãng xe</label><InputText class="form-control mb-2" @bind-Value="XeForm.HangXe" />
                        <label class="form-label">Loại xe</label><InputText class="form-control mb-2" @bind-Value="XeForm.LoaiXe" />
                        <label class="form-label">Giá niêm yết</label><InputNumber class="form-control mb-2" min="0" @bind-Value="XeForm.GiaNiemYet" />
                        <label class="form-label">Giá bán</label><InputNumber class="form-control mb-2" min="0" @bind-Value="XeForm.GiaBan" />
                        <label class="form-label">Ảnh sản phẩm (URL)</label><InputText class="form-control mb-2" @bind-Value="XeForm.HinhAnh" />
                        <label class="form-label">Mô tả</label><InputTextArea class="form-control mb-2" @bind-Value="XeForm.MoTa" />
                        <div class="form-check mb-3"><InputCheckbox class="form-check-input" @bind-Value="XeForm.DangKinhDoanh" /><label class="form-check-label">Đang kinh doanh</label></div>
                        <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu xe</button><button class="btn btn-outline-secondary" type="button" @onclick="DatLaiFormXe">Làm mới</button></div>
                    </EditForm>
                </section>
                <section class="col-xl-8">
                    <div class="table-responsive card border-0 shadow-sm p-2">
                        <table class="table table-striped align-middle">
                            <thead><tr><th>Mã xe</th><th>Tên xe</th><th>Hãng</th><th>Giá</th><th>Tồn</th><th>Trạng thái</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var xe in DanhSachXe)
                                {
                                    <tr>
                                        <td>@xe.MaXe</td><td>@xe.TenXe</td><td>@xe.HangXe</td><td>@xe.GiaBan.ToString("N0") ₫</td><td>@xe.SoLuong</td><td>@(xe.DangKinhDoanh ? "Đang bán" : "Đã ẩn")</td>
                                        <td class="text-nowrap"><button class="btn btn-sm btn-outline-primary" @onclick="() => ChonXe(xe)">Sửa</button>
                                            @if (xe.DangKinhDoanh)
                                            {
                                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => NgungKinhDoanhAsync(xe.Id)">Ẩn</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => MoKinhDoanhAsync(xe.Id)">Mở bán</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
            break;
        case "don-hang":
            @RenderOrders(DonHangs)
            break;
        case "kho":
            <div class="row g-4">
                <section class="col-lg-4">
                    <EditForm Model="DieuChinhKho" OnValidSubmit="CapNhatKhoAsync" class="card card-body border-0 shadow-sm">
                        <DataAnnotationsValidator />
                        <h2 class="h5">Điều chỉnh tồn kho</h2>
                        <label class="form-label">Xe</label>
                        <InputSelect class="form-select mb-2" @bind-Value="DieuChinhKho.XeMayId"><option value="0">Chọn xe</option>@foreach (var xe in DanhSachXe.Where(x => x.DangKinhDoanh)) { <option value="@xe.Id">@xe.TenXe (còn @xe.SoLuong)</option> }</InputSelect>
                        <label class="form-label">Chi nhánh</label>
                        <InputSelect class="form-select mb-2" @bind-Value="DieuChinhKho.ChiNhanhId"><option value="0">Chọn chi nhánh</option>@foreach (var branch in ChiNhanhs) { <option value="@branch.Id">@branch.TenChiNhanh</option> }</InputSelect>
                        <label class="form-label">Số lượng thay đổi (số âm để xuất)</label><InputNumber class="form-control mb-2" @bind-Value="DieuChinhKho.SoLuong" />
                        <label class="form-label">Nhà cung cấp (khi nhập hàng)</label>
                        <InputSelect class="form-select mb-2" @bind-Value="DieuChinhKho.NhaCungCapId"><option value="">Không áp dụng</option>@foreach (var supplier in NhaCungCaps) { <option value="@supplier.Id">@supplier.TenNhaCungCap</option> }</InputSelect>
                        <label class="form-label">Lý do</label><InputText class="form-control mb-3" @bind-Value="DieuChinhKho.GhiChu" />
                        <button class="btn btn-primary" type="submit">Ghi nhận biến động</button>
                    </EditForm>
                    <EditForm Model="ChuyenKhoForm" OnValidSubmit="ChuyenKhoAsync" class="card card-body border-0 shadow-sm mt-3">
                        <DataAnnotationsValidator />
                        <h2 class="h5">Chuyển xe giữa chi nhánh</h2>
                        <label class="form-label">Xe</label>
                        <InputSelect class="form-select mb-2" @bind-Value="ChuyenKhoForm.XeMayId"><option value="0">Chọn xe</option>@foreach (var xe in DanhSachXe.Where(x => x.DangKinhDoanh)) { <option value="@xe.Id">@xe.TenXe</option> }</InputSelect>
                        <label class="form-label">Từ chi nhánh</label>
                        <InputSelect class="form-select mb-2" @bind-Value="ChuyenKhoForm.TuChiNhanhId"><option value="0">Chọn nguồn</option>@foreach (var branch in ChiNhanhs) { <option value="@branch.Id">@branch.TenChiNhanh</option> }</InputSelect>
                        <label class="form-label">Đến chi nhánh</label>
                        <InputSelect class="form-select mb-2" @bind-Value="ChuyenKhoForm.DenChiNhanhId"><option value="0">Chọn đích</option>@foreach (var branch in ChiNhanhs) { <option value="@branch.Id">@branch.TenChiNhanh</option> }</InputSelect>
                        <label class="form-label">Số lượng</label><InputNumber class="form-control mb-3" min="1" @bind-Value="ChuyenKhoForm.SoLuong" />
                        <button class="btn btn-outline-primary" type="submit">Chuyển kho</button>
                    </EditForm>
                </section>
                <section class="col-lg-8"><h2 class="h5">Lịch sử nhập / xuất / kiểm kê</h2>
                    <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Ngày</th><th>Xe</th><th>Chi nhánh</th><th>Loại</th><th>Số lượng</th><th>Ghi chú</th></tr></thead><tbody>
                        @foreach (var movement in BienDongKhos) { <tr><td>@movement.NgayTao.ToLocalTime().ToString("g")</td><td>@movement.TenXe</td><td>@movement.TenChiNhanh</td><td>@movement.LoaiGiaoDich</td><td>@movement.SoLuongThayDoi</td><td>@movement.GhiChu</td></tr> }
                    </tbody></table></div>
                </section>
            </div>
            break;
        case "ban-hang":
            <div class="row g-4">
                <section class="col-lg-5">
                    <EditForm Model="BanHangTaiQuay" OnValidSubmit="TaoDonTaiQuayAsync" class="card card-body border-0 shadow-sm">
                        <DataAnnotationsValidator />
                        <h2 class="h5">Tạo đơn bán tại cửa hàng</h2>
                        <label class="form-label">Chi nhánh bán</label>
                        <InputSelect class="form-select mb-2" @bind-Value="BanHangTaiQuay.ChiNhanhId"><option value="0">Chọn chi nhánh</option>@foreach (var branch in ChiNhanhs) { <option value="@branch.Id">@branch.TenChiNhanh</option> }</InputSelect>
                        <label class="form-label">Khách hàng</label>
                        <InputSelect class="form-select mb-2" @bind-Value="BanHangTaiQuay.KhachHangId"><option value="0">Chọn khách hàng</option>@foreach (var customer in KhachHangs) { <option value="@customer.Id">@customer.HoTen — @customer.Email</option> }</InputSelect>
                        <label class="form-label">Xe</label>
                        <InputSelect class="form-select mb-2" @bind-Value="BanHangTaiQuay.XeMayId"><option value="0">Chọn xe</option>@foreach (var xe in DanhSachXe.Where(x => x.DangKinhDoanh && x.SoLuong > 0)) { <option value="@xe.Id">@xe.TenXe — @xe.GiaBan.ToString("N0") ₫</option> }</InputSelect>
                        <label class="form-label">Số lượng</label><InputNumber class="form-control mb-2" min="1" @bind-Value="BanHangTaiQuay.SoLuong" />
                        <label class="form-label">Người nhận</label><InputText class="form-control mb-2" @bind-Value="BanHangTaiQuay.NguoiNhan" />
                        <label class="form-label">Điện thoại</label><InputText class="form-control mb-2" @bind-Value="BanHangTaiQuay.SoDienThoai" />
                        <label class="form-label">Địa chỉ</label><InputText class="form-control mb-3" @bind-Value="BanHangTaiQuay.DiaChi" />
                        <button class="btn btn-primary" type="submit">Tạo đơn tại quầy</button>
                    </EditForm>
                </section>
                <section class="col-lg-7"><p>Đơn bán tại quầy được ghi nhận trong lịch sử đơn hàng, trừ tồn kho và lưu giao dịch thanh toán tiền mặt.</p></section>
            </div>
            break;
        case "khach-hang":
            <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
                @foreach (var customer in KhachHangs) { <tr><td>@customer.HoTen</td><td>@customer.Email</td><td>@(string.IsNullOrWhiteSpace(customer.PhoneNumber) ? "Chưa cập nhật" : customer.PhoneNumber)</td><td>@customer.NgayTao.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="badge @(customer.DangHoatDong ? "text-bg-success" : "text-bg-secondary")">@(customer.DangHoatDong ? "Hoạt động" : "Đã khóa")</span></td><td class="text-nowrap"><button class="btn btn-sm btn-outline-primary me-1" @onclick="() => XemKhachHangAsync(customer)">Xem tài khoản</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => DoiTrangThaiNguoiDungAsync(customer)">@((customer.DangHoatDong) ? "Khóa" : "Mở khóa")</button></td></tr> }
            </tbody></table></div>
            @if (KhachHangDangXem is not null)
            {
                <section class="card card-body mt-4">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div><span class="admin-nav-label">HỒ SƠ KHÁCH HÀNG</span><h2 class="h5 mt-1">@KhachHangDangXem.HoTen</h2></div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="DongHoSoKhachHang">Đóng</button>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3"><span class="text-secondary small">Email</span><div>@KhachHangDangXem.Email</div></div>
                        <div class="col-md-3"><span class="text-secondary small">Điện thoại</span><div>@(KhachHangDangXem.PhoneNumber ?? "Chưa cập nhật")</div></div>
                        <div class="col-md-3"><span class="text-secondary small">Tạo tài khoản</span><div>@KhachHangDangXem.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                        <div class="col-md-3"><span class="text-secondary small">Xác minh email</span><div>@(KhachHangDangXem.EmailConfirmed ? "Đã xác minh" : "Chưa xác minh")</div></div>
                    </div>
                    <h3 class="h6">Lịch sử đặt hàng (@DonHangKhachDangXem.Count)</h3>
                    @if (DonHangKhachDangXem.Count == 0)
                    {
                        <p class="text-secondary mb-0">Khách hàng chưa có đơn hàng.</p>
                    }
                    else
                    {
                        <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Sản phẩm</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>
                            @foreach (var order in DonHangKhachDangXem)
                            {
                                <tr><td>@order.MaDonHang</td><td>@order.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@string.Join(", ", order.ChiTiet.Select(item => $"{item.TenXe} × {item.SoLuong}"))</td><td>@order.TongTien.ToString("N0") ₫</td><td>@order.TrangThai</td></tr>
                            }
                        </tbody></table></div>
                    }
                </section>
            }
            break;
        case "nha-cung-cap":
            <div class="row g-3"><div class="col-lg-4">
                <EditForm Model="NhaCungCapForm" OnValidSubmit="ThemNhaCungCapAsync" class="card card-body">
                    <DataAnnotationsValidator /><h2 class="h5">Thêm nhà cung cấp</h2>
                    <label class="form-label">Mã nhà cung cấp</label><InputText class="form-control mb-2" @bind-Value="NhaCungCapForm.MaNhaCungCap" />
                    <label class="form-label">Tên</label><InputText class="form-control mb-2" @bind-Value="NhaCungCapForm.TenNhaCungCap" />
                    <label class="form-label">Người liên hệ</label><InputText class="form-control mb-2" @bind-Value="NhaCungCapForm.NguoiLienHe" />
                    <label class="form-label">Điện thoại</label><InputText class="form-control mb-2" @bind-Value="NhaCungCapForm.SoDienThoai" />
                    <label class="form-label">Email</label><InputText class="form-control mb-3" @bind-Value="NhaCungCapForm.Email" />
                    <button class="btn btn-primary">Lưu nhà cung cấp</button>
                </EditForm>
            </div><div class="col-lg-8"><div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Tên</th><th>Liên hệ</th><th>Điện thoại</th></tr></thead><tbody>@foreach (var supplier in NhaCungCaps) { <tr><td>@supplier.MaNhaCungCap</td><td>@supplier.TenNhaCungCap</td><td>@supplier.NguoiLienHe</td><td>@supplier.SoDienThoai</td></tr> }</tbody></table></div></div></div>
            break;
        case "khuyen-mai":
            <div class="row g-3"><div class="col-lg-4">
                <EditForm Model="KhuyenMaiForm" OnValidSubmit="LuuKhuyenMaiAsync" class="card card-body">
                    <DataAnnotationsValidator /><h2 class="h5">@(KhuyenMaiForm.Id == 0 ? "Tạo mã khuyến mãi" : $"Sửa mã {KhuyenMaiForm.MaKhuyenMai}")</h2>
                    <label class="form-label">Mã</label><InputText class="form-control mb-2" @bind-Value="KhuyenMaiForm.MaKhuyenMai" />
                    <label class="form-label">Tên chương trình</label><InputText class="form-control mb-2" @bind-Value="KhuyenMaiForm.TenKhuyenMai" />
                    <label class="form-label">Giá trị giảm</label><InputNumber class="form-control mb-2" min="0" @bind-Value="KhuyenMaiForm.GiaTri" />
                    <div class="form-check mb-2"><InputCheckbox class="form-check-input" @bind-Value="KhuyenMaiForm.TheoPhanTram" /><label class="form-check-label">Giảm theo phần trăm</label></div>
                    <label class="form-label">Đơn tối thiểu</label><InputNumber class="form-control mb-2" min="0" @bind-Value="KhuyenMaiForm.DonToiThieu" />
                    <label class="form-label">Bắt đầu</label><InputDate class="form-control mb-2" @bind-Value="KhuyenMaiForm.BatDau" />
                    <label class="form-label">Kết thúc</label><InputDate class="form-control mb-3" @bind-Value="KhuyenMaiForm.KetThuc" />
                    <div class="form-check mb-3"><InputCheckbox class="form-check-input" @bind-Value="KhuyenMaiForm.DangHoatDong" /><label class="form-check-label">Đang áp dụng</label></div>
                    <div class="d-flex gap-2"><button class="btn btn-primary">@(KhuyenMaiForm.Id == 0 ? "Tạo khuyến mãi" : "Lưu thay đổi")</button>@if (KhuyenMaiForm.Id != 0) { <button type="button" class="btn btn-outline-secondary" @onclick="DatLaiKhuyenMai">Hủy sửa</button> }</div>
                </EditForm>
            </div><div class="col-lg-8"><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Mã</th><th>Tên</th><th>Giá trị</th><th>Thời hạn</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var promotion in KhuyenMais) { <tr><td><strong>@promotion.MaKhuyenMai</strong></td><td>@promotion.TenKhuyenMai</td><td>@promotion.GiaTri @(promotion.TheoPhanTram ? "%" : "₫")<div class="small text-secondary">Đơn tối thiểu @promotion.DonToiThieu.ToString("N0") ₫</div></td><td>@promotion.BatDau.ToLocalTime().ToString("d") – @promotion.KetThuc.ToLocalTime().ToString("d")</td><td><span class="badge @(promotion.DangHoatDong && promotion.KetThuc >= DateTime.UtcNow ? "text-bg-success" : "text-bg-secondary")">@(promotion.DangHoatDong && promotion.KetThuc >= DateTime.UtcNow ? "Đang áp dụng" : "Không hoạt động")</span></td><td class="text-nowrap"><button class="btn btn-sm btn-outline-primary me-1" @onclick="() => SuaKhuyenMai(promotion)">Sửa</button><button class="btn btn-sm btn-outline-danger" @onclick="() => XoaKhuyenMaiAsync(promotion.Id)">Xóa</button></td></tr> }</tbody></table></div></div></div>
            break;
        case "bao-hanh":
            @RenderWarranty()
            break;
        case "ho-tro":
            <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Ngày</th><th>Khách hàng</th><th>Tiêu đề</th><th>Nội dung</th><th>Trạng thái</th><th></th></tr></thead><tbody>
                @foreach (var ticket in PhieuHoTros) { <tr><td>@ticket.NgayTao.ToLocalTime().ToString("g")</td><td>@(ticket.UserEmail ?? "Khách")</td><td>@ticket.TieuDe</td><td>@ticket.NoiDung</td><td>@ticket.TrangThai</td><td><button class="btn btn-sm btn-outline-primary" @onclick="() => CapNhatHoTroAsync(ticket.Id)">Đóng yêu cầu</button></td></tr> }
            </tbody></table></div>
            break;
        case "noi-dung":
            <div class="row g-3"><div class="col-lg-4"><EditForm Model="BaiVietForm" OnValidSubmit="ThemBaiVietAsync" class="card card-body">
                <DataAnnotationsValidator /><h2 class="h5">Đăng tin/bài tư vấn</h2>
                <label class="form-label">Tiêu đề</label><InputText class="form-control mb-2" @bind-Value="BaiVietForm.TieuDe" />
                <label class="form-label">Tóm tắt</label><InputText class="form-control mb-2" @bind-Value="BaiVietForm.TomTat" />
                <label class="form-label">Nội dung</label><InputTextArea class="form-control mb-2" rows="5" @bind-Value="BaiVietForm.NoiDung" />
                <label class="form-label">Loại</label><InputSelect class="form-select mb-2" @bind-Value="BaiVietForm.Loai"><option value="TinTuc">Tin tức</option><option value="TuVan">Tư vấn</option><option value="ChinhSach">Chính sách</option></InputSelect>
                <div class="form-check mb-3"><InputCheckbox class="form-check-input" @bind-Value="BaiVietForm.DaXuatBan" /><label class="form-check-label">Xuất bản</label></div>
                <button class="btn btn-primary">Lưu bài viết</button>
            </EditForm></div><div class="col-lg-8"><div class="table-responsive"><table class="table"><thead><tr><th>Tiêu đề</th><th>Loại</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var article in BaiViets) { <tr><td>@article.TieuDe</td><td>@article.Loai</td><td>@(article.DaXuatBan ? "Đã đăng" : "Bản nháp")</td><td><button class="btn btn-sm btn-outline-secondary" @onclick="() => DoiTrangThaiBaiVietAsync(article)">@(article.DaXuatBan ? "Ẩn" : "Đăng")</button></td></tr> }</tbody></table></div></div></div>
            break;
        case "bao-cao":
            <section class="row g-3">
                <div class="col-md-4"><div class="stat-card"><span>Doanh thu đơn hoàn tất</span><strong>@(ThongKe?.DoanhThu.ToString("N0") ?? "0") ₫</strong></div></div>
                <div class="col-md-4"><div class="stat-card"><span>Đơn hàng</span><strong>@DonHangs.Count</strong></div></div>
                <div class="col-md-4"><div class="stat-card"><span>Xe đang kinh doanh</span><strong>@DanhSachXe.Count(x => x.DangKinhDoanh)</strong></div></div>
            </section>
            <h2 class="h5 mt-4">Hiệu quả sản phẩm đã bán</h2>
            <div class="table-responsive"><table class="table"><thead><tr><th>Xe</th><th>Số lượng bán</th><th>Doanh thu</th></tr></thead><tbody>@foreach (var sales in BaoCaoSanPhams) { <tr><td>@sales.TenXe</td><td>@sales.SoLuong</td><td>@sales.DoanhThu.ToString("N0") ₫</td></tr> }</tbody></table></div>
            break;
        case "nhan-su":
            <h2 class="h5">Nhân viên và vai trò</h2>
            <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Vai trò</th><th>Phạm vi chi nhánh</th><th>Thao tác</th></tr></thead><tbody>
                @foreach (var employee in NhanSu) { <tr><td>@employee.Email</td><td>@employee.HoTen</td><td>@string.Join(", ", VaiTroTheoNguoiDung.GetValueOrDefault(employee.Id, []))</td><td>@(employee.ChiNhanhId is int branchId ? ChiNhanhs.FirstOrDefault(x => x.Id == branchId)?.TenChiNhanh : "Chưa gán")</td><td><select class="form-select form-select-sm d-inline-block w-auto" @bind="VaiTroChon"><option value="">Chọn vai trò</option>@foreach (var role in VaiTros) { <option value="@role.Name">@role.Name</option> }</select> <button class="btn btn-sm btn-outline-primary" @onclick="() => GanVaiTroAsync(employee, true)">Gán</button> <button class="btn btn-sm btn-outline-danger" @onclick="() => GanVaiTroAsync(employee, false)">Thu hồi</button><div class="mt-2"><select class="form-select form-select-sm d-inline-block w-auto" @bind="ChiNhanhChon"><option value="0">Chọn chi nhánh</option>@foreach (var branch in ChiNhanhs) { <option value="@branch.Id">@branch.TenChiNhanh</option> }</select> <button class="btn btn-sm btn-outline-secondary" @onclick="() => GanChiNhanhAsync(employee, true)">Gán phạm vi</button><button class="btn btn-sm btn-link text-danger" @onclick="() => GanChiNhanhAsync(employee, false)">Thu hồi</button></div></td></tr> }
            </tbody></table></div>
            <h2 class="h5 mt-4">Ma trận quyền</h2>
            <div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Vai trò</th>@foreach (var permission in QuyenHeThongs) { <th>@permission.TenQuyen</th> }</tr></thead><tbody>
                @foreach (var role in VaiTros.Where(x => x.Name != "QuanTriVien")) { <tr><th>@role.Name</th>@foreach (var permission in QuyenHeThongs) { <td><input type="checkbox" checked="@QuyenDaGan.Contains((role.Id, permission.Id))" @onchange="e => CapNhatQuyenAsync(role.Id, permission.Id, e)" aria-label="@($"{role.Name}: {permission.TenQuyen}")" /></td> }</tr> }
            </tbody></table></div>
            break;
        case "chi-nhanh":
            <div class="row g-4"><section class="col-lg-4"><EditForm Model="ChiNhanhForm" OnValidSubmit="ThemChiNhanhAsync" class="card card-body">
                <DataAnnotationsValidator /><h2 class="h5">Thêm chi nhánh</h2>
                <label class="form-label">Mã chi nhánh</label><InputText class="form-control mb-2" @bind-Value="ChiNhanhForm.MaChiNhanh" />
                <label class="form-label">Tên</label><InputText class="form-control mb-2" @bind-Value="ChiNhanhForm.TenChiNhanh" />
                <label class="form-label">Địa chỉ</label><InputText class="form-control mb-2" @bind-Value="ChiNhanhForm.DiaChi" />
                <label class="form-label">Điện thoại</label><InputText class="form-control mb-3" @bind-Value="ChiNhanhForm.SoDienThoai" />
                <button class="btn btn-primary">Lưu chi nhánh</button>
            </EditForm></section><section class="col-lg-8"><div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Chi nhánh</th><th>Địa chỉ</th><th>Điện thoại</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var branch in ChiNhanhs) { <tr><td>@branch.MaChiNhanh</td><td>@branch.TenChiNhanh</td><td>@branch.DiaChi</td><td>@branch.SoDienThoai</td><td>@(branch.DangHoatDong ? "Hoạt động" : "Đã đóng")</td></tr> }</tbody></table></div></section></div>
            break;
        case "thong-bao":
            <EditForm Model="ThongBaoForm" OnValidSubmit="GuiThongBaoAsync" class="card card-body border-0 shadow-sm mb-4">
                <DataAnnotationsValidator /><h2 class="h5">Gửi thông báo</h2>
                <label class="form-label">Tiêu đề</label><InputText class="form-control mb-2" @bind-Value="ThongBaoForm.TieuDe" />
                <label class="form-label">Nội dung</label><InputTextArea class="form-control mb-2" @bind-Value="ThongBaoForm.NoiDung" />
                <label class="form-label">Tài khoản nhận (để trống gửi tất cả)</label><InputSelect class="form-select mb-3" @bind-Value="ThongBaoForm.NguoiDungId"><option value="">Tất cả khách hàng</option>@foreach (var customer in KhachHangs) { <option value="@customer.Id">@customer.Email</option> }</InputSelect>
                <button class="btn btn-primary align-self-start">Gửi</button>
            </EditForm>
            <div class="table-responsive"><table class="table"><thead><tr><th>Ngày</th><th>Người nhận</th><th>Tiêu đề</th><th>Nội dung</th></tr></thead><tbody>@foreach (var notification in ThongBaos) { <tr><td>@notification.NgayTao.ToLocalTime().ToString("g")</td><td>@(notification.NguoiDungId?.ToString() ?? "Tất cả")</td><td>@notification.TieuDe</td><td>@notification.NoiDung</td></tr> }</tbody></table></div>
            break;
        case "nhat-ky":
            <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Thời gian</th><th>Tài khoản</th><th>Thao tác</th><th>Đối tượng</th><th>Chi tiết</th><th>IP</th></tr></thead><tbody>@foreach (var log in NhatKys) { <tr><td>@log.NgayTao.ToLocalTime().ToString("g")</td><td>@log.NguoiDungId</td><td>@log.HanhDong</td><td>@log.DoiTuong</td><td>@log.ChiTiet</td><td>@log.DiaChiIp</td></tr> }</tbody></table></div>
            break;
        case "cau-hinh":
            <EditForm Model="CauHinhForm" OnValidSubmit="LuuCauHinhAsync" class="card card-body border-0 shadow-sm mb-4">
                <DataAnnotationsValidator /><h2 class="h5">Cấu hình cửa hàng</h2>
                <label class="form-label">Khóa cấu hình</label><InputText class="form-control mb-2" @bind-Value="CauHinhForm.Khoa" />
                <label class="form-label">Giá trị</label><InputText class="form-control mb-3" @bind-Value="CauHinhForm.GiaTri" />
                <button class="btn btn-primary align-self-start">Lưu cấu hình</button>
            </EditForm>
            <div class="table-responsive"><table class="table"><thead><tr><th>Khóa</th><th>Giá trị</th></tr></thead><tbody>@foreach (var setting in CauHinhs) { <tr><td>@setting.Khoa</td><td>@setting.GiaTri</td><td><button class="btn btn-sm btn-link" @onclick="() => ChonCauHinh(setting)">Sửa</button></td></tr> }</tbody></table></div>
            break;
        default:
            <div class="alert alert-warning">Phân hệ không tồn tại. Hãy chọn một mục trong menu quản trị.</div>
            break;
    }
}

@code {
    [Parameter] public string? Module { get; set; }
    [SupplyParameterFromQuery(Name = "xeId")]
    public int? XeId { get; set; }

    private string ModuleHienTai => string.IsNullOrWhiteSpace(Module) ? "dashboard" : Module.ToLowerInvariant();
    private string TenTrang => ModuleHienTai switch
    {
        "dashboard" => "Tổng quan cửa hàng",
        "san-pham" => "Quản lý sản phẩm",
        "don-hang" => "Quản lý đơn hàng & thanh toán",
        "ban-hang" => "Bán hàng tại quầy",
        "kho" => "Quản lý kho",
        "khach-hang" => "Quản lý khách hàng",
        "nha-cung-cap" => "Nhà cung cấp",
        "khuyen-mai" => "Khuyến mãi",
        "bao-hanh" => "Bảo hành và bảo dưỡng",
        "ho-tro" => "Yêu cầu hỗ trợ",
        "noi-dung" => "Quản lý nội dung",
        "bao-cao" => "Báo cáo kinh doanh",
        "nhan-su" => "Nhân sự & phân quyền",
        "chi-nhanh" => "Quản lý chi nhánh",
        "thong-bao" => "Thông báo",
        "nhat-ky" => "Nhật ký hệ thống",
        "cau-hinh" => "Cấu hình cửa hàng",
        _ => "Quản trị cửa hàng"
    };

    private string MaQuyen => ModuleHienTai switch
    {
        "san-pham" => "products.view",
        "kho" => "inventory.view",
        "don-hang" or "ban-hang" => "orders.view",
        "khach-hang" => "customers.view",
        "nha-cung-cap" => "inventory.manage",
        "khuyen-mai" or "noi-dung" => "products.manage",
        "bao-hanh" => "warranty.manage",
        "bao-cao" => "reports.view",
        "nhan-su" => "roles.manage",
        "chi-nhanh" or "thong-bao" or "nhat-ky" or "cau-hinh" => "settings.manage",
        "ho-tro" => "customers.manage",
        _ => "reports.view"
    };

    private AppUser? NguoiDung { get; set; }
    private bool DangTai { get; set; } = true;
    private bool CoQuyen { get; set; }
    private bool ToanHeThong { get; set; }
    private List<int> ChiNhanhDuocCap { get; set; } = [];
    private bool ThanhCong { get; set; }
    private string? ThongBao { get; set; }
    private DashboardThongKe? ThongKe { get; set; }
    private List<XeMayModel> DanhSachXe { get; set; } = [];
    private List<DonHangEntity> DonHangs { get; set; } = [];
    private List<AppUser> KhachHangs { get; set; } = [];
    private AppUser? KhachHangDangXem { get; set; }
    private List<DonHangEntity> DonHangKhachDangXem { get; set; } = [];
    private List<AppUser> NhanSu { get; set; } = [];
    private List<IdentityRole<int>> VaiTros { get; set; } = [];
    private Dictionary<int, List<string>> VaiTroTheoNguoiDung { get; set; } = [];
    private List<QuyenHeThong> QuyenHeThongs { get; set; } = [];
    private HashSet<(int RoleId, int PermissionId)> QuyenDaGan { get; set; } = [];
    private List<ChiNhanh> ChiNhanhs { get; set; } = [];
    private List<NhaCungCap> NhaCungCaps { get; set; } = [];
    private List<KhuyenMai> KhuyenMais { get; set; } = [];
    private List<YeuCauBaoHanh> YeuCauBaoHanhs { get; set; } = [];
    private List<(int Id, string MoTa, string TrangThai, DateTime NgayTao, string? UserEmail)> YeuCauBaoHanhHienThi { get; set; } = [];
    private List<(int Id, string TieuDe, string NoiDung, string TrangThai, DateTime NgayTao, string? UserEmail)> PhieuHoTros { get; set; } = [];
    private List<BaiViet> BaiViets { get; set; } = [];
    private List<ThongBaoNguoiDung> ThongBaos { get; set; } = [];
    private List<NhatKyHeThong> NhatKys { get; set; } = [];
    private List<CauHinhCuaHang> CauHinhs { get; set; } = [];
    private List<(string TenXe, int SoLuong, decimal DoanhThu)> BaoCaoSanPhams { get; set; } = [];
    private List<(DateTime NgayTao, string TenXe, string TenChiNhanh, string LoaiGiaoDich, int SoLuongThayDoi, string GhiChu)> BienDongKhos { get; set; } = [];
    private ProductForm XeForm { get; set; } = new();
    private InventoryForm DieuChinhKho { get; set; } = new();
    private TransferForm ChuyenKhoForm { get; set; } = new();
    private PosForm BanHangTaiQuay { get; set; } = new();
    private SupplierForm NhaCungCapForm { get; set; } = new();
    private PromotionForm KhuyenMaiForm { get; set; } = new();
    private ArticleForm BaiVietForm { get; set; } = new();
    private BranchForm ChiNhanhForm { get; set; } = new();
    private NotificationForm ThongBaoForm { get; set; } = new();
    private SettingForm CauHinhForm { get; set; } = new();
    private string? VaiTroChon { get; set; }
    private int ChiNhanhChon { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        DangTai = true;
        ThongBao = null;
        try
        {
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            NguoiDung = await UserManager.GetUserAsync(authentication.User);
            if (NguoiDung is null)
            {
                CoQuyen = false;
                return;
            }

            ToanHeThong = await PermissionService.CoPhamViToanHeThongAsync(authentication.User);
            ChiNhanhDuocCap = await PermissionService.LayChiNhanhDuocCapAsync(authentication.User);
            CoQuyen = await PermissionService.CoQuyenAsync(authentication.User, MaQuyen);
            var branchScoped = ModuleHienTai is "dashboard" or "bao-cao" or "don-hang" or "ban-hang"
                or "kho" or "khach-hang" or "bao-hanh" or "ho-tro";
            if (branchScoped && !ToanHeThong && ChiNhanhDuocCap.Count == 0)
            {
                CoQuyen = false;
            }

            if (!CoQuyen)
            {
                return;
            }

            await TaiDuLieuAsync();
            if (ModuleHienTai == "san-pham" && XeId is int xeId)
            {
                var xe = DanhSachXe.FirstOrDefault(item => item.Id == xeId);
                if (xe is not null)
                {
                    ChonXe(xe);
                }
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Không thể tải phân hệ quản trị {Module}.", ModuleHienTai);
            ThongBao = "Không thể tải dữ liệu quản trị lúc này.";
            ThanhCong = false;
        }
        finally
        {
            DangTai = false;
        }
    }

    private async Task TaiDuLieuAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        switch (ModuleHienTai)
        {
            case "dashboard":
            case "bao-cao":
                ThongKe = await DichVuQuanTri.LayThongKeAsync(ToanHeThong ? null : ChiNhanhDuocCap);
                DanhSachXe = await XeMayService.LayTatCaXeAsync();
                DonHangs = await DichVuQuanTri.LayDonHangAsync(ToanHeThong ? null : ChiNhanhDuocCap);
                var completedOrders = db.DonHangs.Where(x => x.TrangThai == "HoanThanh");
                if (!ToanHeThong)
                {
                    completedOrders = completedOrders.Where(x => ChiNhanhDuocCap.Contains(x.ChiNhanhId ?? 0));
                }

                var productReport = await db.ChiTietDonHangs
                    .Join(completedOrders,
                        item => item.DonHangId, order => order.Id, (item, _) => item)
                    .GroupBy(x => x.TenXe)
                    .Select(group => new
                    {
                        TenXe = group.Key,
                        SoLuong = group.Sum(x => x.SoLuong),
                        DoanhThu = group.Sum(x => x.SoLuong * x.DonGia)
                    })
                    .OrderByDescending(x => x.DoanhThu).ToListAsync();
                BaoCaoSanPhams = productReport
                    .Select(x => (x.TenXe, x.SoLuong, x.DoanhThu)).ToList();
                break;
            case "san-pham":
                DanhSachXe = await XeMayService.LayTatCaXeAsync();
                break;
            case "don-hang":
            case "ban-hang":
                DonHangs = await DichVuQuanTri.LayDonHangAsync(ToanHeThong ? null : ChiNhanhDuocCap);
                if (ModuleHienTai == "ban-hang")
                {
                    await LoadCustomersAsync();
                    DanhSachXe = await LayXeTheoPhamViKhoAsync(db);
                    ChiNhanhs = await LayChiNhanhTrongPhamViAsync(db);
                }
                break;
            case "kho":
                DanhSachXe = await LayXeTheoPhamViKhoAsync(db);
                ChiNhanhs = await LayChiNhanhTrongPhamViAsync(db);
                NhaCungCaps = await db.NhaCungCaps.AsNoTracking().Where(x => x.DangHoatDong).OrderBy(x => x.TenNhaCungCap).ToListAsync();
                var movements = db.BienDongKhos.AsQueryable();
                if (!ToanHeThong)
                {
                    movements = movements.Where(x => ChiNhanhDuocCap.Contains(x.ChiNhanhId));
                }

                var movementRows = await movements
                    .Join(db.XeMays, movement => movement.XeMayId, product => product.Id, (movement, product) => new { movement, product })
                    .Join(db.ChiNhanhs, pair => pair.movement.ChiNhanhId, branch => branch.Id,
                        (pair, branch) => new
                        {
                            pair.movement.NgayTao,
                            TenXe = pair.product.TenXe,
                            TenChiNhanh = branch.TenChiNhanh,
                            pair.movement.LoaiGiaoDich,
                            pair.movement.SoLuongThayDoi,
                            pair.movement.GhiChu
                        })
                    .OrderByDescending(x => x.NgayTao).Take(100).ToListAsync();
                BienDongKhos = movementRows
                    .Select(x => (x.NgayTao, x.TenXe, x.TenChiNhanh,
                        x.LoaiGiaoDich, x.SoLuongThayDoi, x.GhiChu)).ToList();
                break;
            case "khach-hang":
                await LoadCustomersAsync();
                break;
            case "nha-cung-cap":
                NhaCungCaps = await db.NhaCungCaps.AsNoTracking().OrderBy(x => x.TenNhaCungCap).ToListAsync();
                break;
            case "khuyen-mai":
                KhuyenMais = await db.KhuyenMais.AsNoTracking().OrderByDescending(x => x.BatDau).ToListAsync();
                break;
            case "bao-hanh":
                var warrantyRequests = db.YeuCauBaoHanhs.AsQueryable();
                if (!ToanHeThong)
                {
                    warrantyRequests = warrantyRequests.Where(x => x.DonHangId.HasValue
                        && db.DonHangs.Any(order => order.Id == x.DonHangId.Value
                            && ChiNhanhDuocCap.Contains(order.ChiNhanhId ?? 0)));
                }

                var warrantyRows = await warrantyRequests
                    .Join(db.Users, request => request.NguoiDungId, user => user.Id,
                        (request, user) => new
                        {
                            request.Id,
                            request.MoTa,
                            request.TrangThai,
                            request.NgayTao,
                            UserEmail = user.Email
                        })
                    .OrderByDescending(x => x.NgayTao).ToListAsync();
                YeuCauBaoHanhHienThi = warrantyRows
                    .Select(x => (x.Id, x.MoTa, x.TrangThai, x.NgayTao, x.UserEmail)).ToList();
                break;
            case "ho-tro":
                var tickets = db.PhieuHoTros.AsQueryable();
                if (!ToanHeThong)
                {
                    var scopedCustomerIds = db.Users
                        .Where(user => user.ChiNhanhId.HasValue && ChiNhanhDuocCap.Contains(user.ChiNhanhId.Value))
                        .Select(user => user.Id)
                        .Union(db.DonHangs.Where(order => ChiNhanhDuocCap.Contains(order.ChiNhanhId ?? 0))
                            .Select(order => order.NguoiDungId));
                    tickets = tickets.Where(ticket => ticket.NguoiDungId.HasValue
                        && scopedCustomerIds.Contains(ticket.NguoiDungId.Value));
                }

                var ticketRows = await tickets
                    .GroupJoin(db.Users, ticket => ticket.NguoiDungId, user => user.Id,
                        (ticket, users) => new { ticket, user = users.Select(x => x.Email).FirstOrDefault() })
                    .Select(x => new
                    {
                        x.ticket.Id,
                        x.ticket.TieuDe,
                        x.ticket.NoiDung,
                        x.ticket.TrangThai,
                        x.ticket.NgayTao,
                        UserEmail = x.user
                    })
                    .OrderByDescending(x => x.NgayTao).ToListAsync();
                PhieuHoTros = ticketRows
                    .Select(x => (x.Id, x.TieuDe, x.NoiDung, x.TrangThai, x.NgayTao, x.UserEmail)).ToList();
                break;
            case "noi-dung":
                BaiViets = await db.BaiViets.AsNoTracking().OrderByDescending(x => x.NgayTao).ToListAsync();
                break;
            case "nhan-su":
                NhanSu = await DichVuQuanTri.LayNhanSuAsync();
                VaiTros = await DichVuQuanTri.LayVaiTrosAsync();
                ChiNhanhs = await LayChiNhanhTrongPhamViAsync(db);
                foreach (var user in NhanSu)
                {
                    VaiTroTheoNguoiDung[user.Id] = (await UserManager.GetRolesAsync(user)).ToList();
                }

                QuyenHeThongs = await PermissionService.LayDanhSachQuyenAsync();
                var assignments = await db.GanQuyenVaiTros.AsNoTracking()
                    .Select(x => new { RoleId = x.VaiTroId, PermissionId = x.QuyenId })
                    .ToListAsync();
                QuyenDaGan = assignments.Select(x => (x.RoleId, x.PermissionId)).ToHashSet();
                break;
            case "chi-nhanh":
                ChiNhanhs = await db.ChiNhanhs.AsNoTracking().OrderBy(x => x.TenChiNhanh).ToListAsync();
                break;
            case "thong-bao":
                await LoadCustomersAsync();
                ThongBaos = await db.ThongBaoNguoiDungs.AsNoTracking().OrderByDescending(x => x.NgayTao)
                    .Take(200).ToListAsync();
                break;
            case "nhat-ky":
                NhatKys = await db.NhatKyHeThongs.AsNoTracking().OrderByDescending(x => x.NgayTao)
                    .Take(300).ToListAsync();
                break;
            case "cau-hinh":
                CauHinhs = await db.CauHinhCuaHangs.AsNoTracking().OrderBy(x => x.Khoa).ToListAsync();
                break;
        }
    }

    private async Task LoadCustomersAsync()
    {
        var users = (await UserManager.GetUsersInRoleAsync("User")).ToList();
        if (!ToanHeThong)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var allowedUserIds = await db.DonHangs
                .Where(x => ChiNhanhDuocCap.Contains(x.ChiNhanhId ?? 0))
                .Select(x => x.NguoiDungId).Distinct().ToListAsync();
            users = users.Where(x => allowedUserIds.Contains(x.Id)
                || x.ChiNhanhId.HasValue && ChiNhanhDuocCap.Contains(x.ChiNhanhId.Value)).ToList();
        }

        KhachHangs = users;
    }

    private async Task<List<ChiNhanh>> LayChiNhanhTrongPhamViAsync(AppDbContext db)
    {
        var branches = db.ChiNhanhs.AsNoTracking().Where(x => x.DangHoatDong);
        if (!ToanHeThong)
        {
            branches = branches.Where(x => ChiNhanhDuocCap.Contains(x.Id));
        }

        return await branches.OrderBy(x => x.TenChiNhanh).ToListAsync();
    }

    private async Task<List<XeMayModel>> LayXeTheoPhamViKhoAsync(AppDbContext db)
    {
        var products = await XeMayService.LayTatCaXeAsync();
        if (!ToanHeThong)
        {
            var stockByProduct = await db.TonKhoChiNhanhs
                .Where(x => ChiNhanhDuocCap.Contains(x.ChiNhanhId))
                .GroupBy(x => x.XeMayId)
                .Select(group => new { ProductId = group.Key, Quantity = group.Sum(x => x.SoLuong) })
                .ToDictionaryAsync(x => x.ProductId, x => x.Quantity);
            foreach (var product in products)
            {
                product.SoLuong = stockByProduct.GetValueOrDefault(product.Id);
            }
        }

        return products;
    }

