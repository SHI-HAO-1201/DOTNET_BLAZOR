@page "/danh-sach-xe"
@using BlazorXe_Xemay.Features.XeMay.Models
@using BlazorXe_Xemay.Features.XeMay.Services
@inject XeMayService XeMayService

<PageTitle>Danh sách xe máy</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Quản lý Danh Sách Xe Máy</h3>
        <button class="btn btn-primary" @onclick="ThemXeMoi">
            <i class="bi bi-plus-circle"></i> Thêm xe mới
        </button>
    </div>

    @if (danhSachXe == null)
    {
        <p><em>Đang tải dữ liệu...</em></p>
    }
    else if (!danhSachXe.Any())
    {
        <div class="alert alert-warning">Chưa có dữ liệu xe máy nào trong hệ thống.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tên Xe</th>
                        <th>Hãng Xe</th>
                        <th>Giá Bán</th>
                        <th>Số Lượng</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var xe in danhSachXe)
                    {
                        <tr>
                            <td>@xe.Id</td>
                            <td><strong>@xe.TenXe</strong></td>
                            <td>@xe.HangXe</td>
                            <td>@xe.GiaBan.ToString("N0") VNĐ</td>
                            <td>@xe.SoLuong</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning me-2" @onclick="() => SuaXe(xe.Id)">Sửa</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => XoaXe(xe.Id)">Xóa</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<XeMayModel>? danhSachXe;

    protected override async Task OnInitializedAsync()
    {
        // Lấy dữ liệu từ service khi component được khởi tạo
        danhSachXe = await XeMayService.LayDanhSachXeAsync();
    }

    private void ThemXeMoi()
    {
        // Tạm thời thông báo, chúng ta sẽ làm form thêm mới sau
        // Hoặc điều hướng đến trang thêm xe
    }

    private void SuaXe(int id)
    {
        // Logic sửa xe
    }

    private void XoaXe(int id)
    {
        // Logic xóa xe
    }
}